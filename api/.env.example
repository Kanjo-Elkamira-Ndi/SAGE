# SAGE API — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# Server
PORT=4000
NODE_ENV=development

# Postgres connection string (local dev — managed in DBeaver)
DATABASE_URL=postgresql://postgresql:codex4587@localhost:5432/sage

# JWT — use two distinct random secrets (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Allowed browser origins (comma-separated) for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Used to build password-reset links
FRONTEND_URL=http://localhost:5173

# --- SMTP (needed for emailed reset links; optional until then) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=SAGE <no-reply@sage.app>

# --- Supabase (Phase 2: Storage) ---
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<publishable key — safe for frontends>
# SUPABASE_SERVICE_ROLE_KEY=<secret key — server-side ONLY, never expose>
# SUPABASE_STORAGE_BUCKET=materials

# --- Needed by later phases ---
# --- Phase 5 (AI quiz generation) — server-side only ---
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MAX_TOKENS=2048
# GROQ_TEMPERATURE=0.7
# QUIZ_GENERATE_MAX_PER_MINUTE=6
# MAX_MATERIAL_TEXT_CHARS=15000

# --- Phase 7 (Notifications & cron) ---
# DEADLINE_REMINDER_WINDOWS=48,24,2
